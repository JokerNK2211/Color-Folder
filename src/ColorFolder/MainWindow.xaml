<Window x:Class="ColorFolder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Folder" Width="860" Height="640" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F7F7F9"
        FontFamily="Segoe UI, Leelawadee UI" FontSize="13">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Folders -->
        <DockPanel Grid.Column="0">
            <TextBlock x:Name="FoldersTitle" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="AddButton" Click="AddFolder_Click" />
                <Button x:Name="RemoveButton" Click="RemoveFolder_Click" />
            </StackPanel>
            <Grid>
                <ListBox x:Name="FolderList" AllowDrop="True" Drop="FolderList_Drop" DragOver="FolderList_DragOver"
                         SelectionMode="Extended" Background="White" />
                <TextBlock x:Name="DropHint" TextWrapping="Wrap" Foreground="#888" Margin="16"
                           VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <!-- Options -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="LanguageButton" DockPanel.Dock="Right" Margin="0" Click="Language_Click" />
                    <TextBlock x:Name="StyleTitle" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton x:Name="StyleMac" GroupName="style" Margin="0,0,16,0" Checked="Style_Checked" />
                    <RadioButton x:Name="StyleWindows" GroupName="style" Margin="0,0,16,0" Checked="Style_Checked" />
                    <RadioButton x:Name="StyleTemplate" GroupName="style" Checked="Style_Checked" />
                </StackPanel>
                <StackPanel x:Name="TemplateRow" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="PickTemplateButton" Click="PickTemplate_Click" />
                    <TextBlock x:Name="TemplateName" VerticalAlignment="Center" Foreground="#666" />
                </StackPanel>

                <TextBlock x:Name="ColorsTitle" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,8" />
                <WrapPanel x:Name="ColorPanel" />

                <TextBlock x:Name="BadgesTitle" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,8" />
                <WrapPanel x:Name="BadgePanel" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Border Background="White" CornerRadius="8" Padding="8" Margin="0,0,16,0">
                        <Image x:Name="PreviewImage" Width="128" Height="128" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <CheckBox x:Name="MenuCheck" Margin="0,0,0,8" Checked="Menu_Changed" Unchecked="Menu_Changed" />
                        <CheckBox x:Name="PortableCheck" Margin="0,0,0,8" Checked="Portable_Changed" Unchecked="Portable_Changed" />
                        <Button x:Name="RefreshButton" HorizontalAlignment="Left" Click="Refresh_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ImportButton" Click="Import_Click" />
                <Button x:Name="ResetButton" Click="Reset_Click" />
                <Button x:Name="ApplyButton" Click="Apply_Click" Margin="0" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="#555" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
